{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "src/portal/**/.cache": true,
    "src/portal/**/.tmp": true,
    "**/*.log": true
  },
  "search.exclude": {
    "src/portal/**/.cache": true,
    "src/portal/**/.tmp": true,
    "**/yaml-syntax-errors.txt": true
  },
  "files.watcherExclude": {
    "src/portal/**/.cache/**": true,
    "src/portal/**/.tmp/**": true
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[html]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[liquid]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[powershell]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
